# Keys for the provider spike (FRD §17). Copy this file to .env.local and fill in
# the keys you have. .env.local is ignored by git. Never commit a real key.
# Only the spike page (bun run spike) reads these. Leave a line empty to skip
# that provider: the page then uses a made-up key and checks browser access only.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
FIRECRAWL_API_KEY=

# Optional: the model each provider uses for the AI SDK checks.
ANTHROPIC_MODEL=
OPENAI_MODEL=
GEMINI_MODEL=
OPENROUTER_MODEL=
NVIDIA_MODEL=
